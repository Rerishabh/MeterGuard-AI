# =====================================================================
# MeterGuard AI - Environment Configuration Template
# =====================================================================
# Copy this file to '.env' in the project root for the FastAPI backend:
#   PowerShell: copy .env.example .env
#   Bash:       cp .env.example .env
#
# For frontend configuration, create 'frontend/.env' (see bottom of file).
# =====================================================================

# ---------------------------------------------------------------------
# Database Configuration (MySQL 8.0+ / MariaDB 10.5+)
# Format: mysql+pymysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
# Recommended database name: meterguard_ai
# ---------------------------------------------------------------------
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/meterguard_ai

# ---------------------------------------------------------------------
# FastAPI Application Server
# ---------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=5000

# ---------------------------------------------------------------------
# Machine Learning Model & Artifact Paths (Relative to project root)
# ---------------------------------------------------------------------
MODEL1_PATH=models/isolation_forest_final.joblib
MODEL2_PATH=models/sih_fault_detection_model_2.joblib
ML_ARTIFACTS_DIR=ml/artifacts

# ---------------------------------------------------------------------
# Optional: Google Gemini GenAI Configuration (Investigation Briefs)
# ---------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# =====================================================================
# Frontend Configuration Note:
# =====================================================================
# The React + Vite frontend reads VITE_API_BASE_URL from 'frontend/.env'
# Default fallback in frontend/src/services/api.js is http://localhost:5000
#
# To explicitly configure frontend, create 'frontend/.env':
#   VITE_API_BASE_URL=http://127.0.0.1:5000
# Note: Vite requires a development server restart when .env changes.
# =====================================================================
