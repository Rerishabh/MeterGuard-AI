# =====================================================================
# MeterGuard AI - Environment Configuration Template
# =====================================================================
# Copy this file to '.env' in the project root for the FastAPI backend:
#   PowerShell: copy .env.example .env
#   Bash:       cp .env.example .env
#
# For frontend configuration, create 'frontend/.env' (see bottom of file).
# =====================================================================

# ---------------------------------------------------------------------
# Database Configuration (MySQL 8.0+ / MariaDB 10.5+ / TiDB Cloud Starter)
# Local Format: mysql+pymysql://<DB_USER>:<DB_PASSWORD>@localhost:3306/meterguard_ai
# TiDB Cloud:   mysql+pymysql://<USER>.<PREFIX>:<PASSWORD>@<GATEWAY_HOST>:4000/meterguard_ai
# Note: DATABASE_URL is strictly required; no default password fallback is used.
# ---------------------------------------------------------------------
DATABASE_URL=mysql+pymysql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:3306/meterguard_ai

# ---------------------------------------------------------------------
# FastAPI Application Server & Port Binding
# Render automatically injects PORT (e.g. 10000); local uses API_PORT
# ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=5000
PORT=5000

# ---------------------------------------------------------------------
# Configurable CORS Origins
# Comma-separated list of allowed origins.
# Local development origins (localhost:5173, etc.) are always included automatically.
# Example for deployed Cloudflare Pages:
# CORS_ORIGINS=https://meterguard-ai.pages.dev
# ---------------------------------------------------------------------
CORS_ORIGINS=https://meterguard-ai.pages.dev

# ---------------------------------------------------------------------
# Machine Learning Model & Artifact Paths (Relative to project root)
# ---------------------------------------------------------------------
MODEL1_PATH=models/isolation_forest_final.joblib
MODEL2_PATH=models/sih_fault_detection_model_2.joblib
ML_ARTIFACTS_DIR=ml/artifacts

# ---------------------------------------------------------------------
# Optional: Google Gemini GenAI Configuration (Investigation Briefs)
# ---------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# =====================================================================
# Frontend Configuration Note (Cloudflare Pages):
# =====================================================================
# The React + Vite frontend reads VITE_API_BASE_URL at build time.
# Default fallback in frontend/src/services/api.js is http://localhost:5000
#
# For Cloudflare Pages deployment, set the environment variable:
#   VITE_API_BASE_URL=https://<your-render-service>.onrender.com
# For local frontend development, in 'frontend/.env':
#   VITE_API_BASE_URL=http://localhost:5000
# Note: Vite requires a server rebuild/restart when .env changes.
# =====================================================================
